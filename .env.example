# Identifiants des fournisseurs LLM — copier en `.env` à la racine.
# `.env` est déjà dans .gitignore ; ce fichier-ci est le seul versionné, et il ne
# doit JAMAIS contenir de clé réelle.
#
# Le backend est un client OpenAI-compatible générique (`policies/llm/backend.py`).
# Ajouter un fournisseur = ajouter DEUX variables ici, `{PROVIDER}_BASE_URL` et
# `{PROVIDER}_API_KEY`, puis référencer `provider: <nom en minuscules>` dans
# `controla/policies/llm/models.yaml`. Aucun code à toucher.
#
# Vérifier que tout est en place, sans jouer une seule partie :
#   python -m controla.cli models --check

# ── OpenRouter — fournisseur par défaut du banc ──────────────────────────────
# Une seule clé donne accès à des centaines de modèles de tous les éditeurs, tous
# derrière la même API. C'est ce qui permet de comparer des modèles concurrents
# sans multiplier les comptes, les quotas et les formats d'erreur.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-remplacer-par-votre-cle

# Facultatif — attribution OpenRouter. Ces deux valeurs sont envoyées en en-têtes
# `HTTP-Referer` et `X-Title` ; elles n'ont aucun effet sur les réponses.
OPENROUTER_APP_URL=https://github.com/exemple/controla
OPENROUTER_APP_NAME=Controla

# ── Fournisseurs directs, si vous préférez court-circuiter OpenRouter ────────
# Décommenter la paire voulue, et rien d'autre : un fournisseur dont les deux
# variables sont absentes est simplement ignoré tant qu'aucun modèle ne le vise.

# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=gsk_...

# Anthropic expose une couche de compatibilité OpenAI, mais elle ne peut PAS
# exprimer `cache_control` (qui s'annote par bloc de contenu, ce que le schéma
# chat-completions n'a pas). Le cache de prompt — 82 % du coût d'un appel ici,
# cf. docs/FINDINGS.md n° 5 — reste donc inaccessible par cette voie.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_API_KEY=sk-ant-...

# TOGETHER_BASE_URL=https://api.together.xyz/v1
# TOGETHER_API_KEY=...

# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-...

# Serveur local (llama.cpp, vLLM, Ollama…) : la clé est ignorée mais doit être
# non vide, le SDK refusant de partir sans.
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_API_KEY=peu-importe
